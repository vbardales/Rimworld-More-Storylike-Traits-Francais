<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!--
      The namespace is the one the original mod shipped, because the defs name it verbatim:
      <li Class="MoreStorylikeTraits.MSTModExtension">. Changing it would break every
      ThoughtDef in the mod and every save that already carries one.

      The assembly FILE, on the other hand, was called "HYP's MoreStorylikeTraits.dll".
      An apostrophe in a DLL name is a needless hazard on every tool that touches it, and the
      file name has no bearing on type resolution: RimWorld loads every assembly in
      Assemblies/ and looks the types up by full name. So the file is renamed and the
      namespace is not.
    -->
    <RootNamespace>MoreStorylikeTraits</RootNamespace>
    <AssemblyName>MoreStorylikeTraits</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\Mod\Assemblies\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- No Harmony and no publicizer: the mod only adds a DefModExtension and a ThoughtWorker. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" />
  </ItemGroup>

</Project>
