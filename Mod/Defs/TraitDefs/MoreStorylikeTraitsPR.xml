      <li>HYPSSR07FieldSniper</li>
      <li>HYPSSR10YuZuSoftFan</li>
      <li>HYPSSR12DolphinVoiceTalent</li>
      <li>HYPSSR15MasterOfNegotiations</li>
      <li>HYPUR03TheDealWithLucifer</li>
      <li>HYPSSR13FirearmsExpert</li>
    </conflictingTraits>
    <requiredWorkTags>
      <li>Artistic</li>
    </requiredWorkTags>
  </TraitDef>

  <TraitDef>
    <defName>HYPSSR15MasterOfNegotiations</defName><!-- 谈判大师 -->
    <commonality>0.1</commonality>
    <forcedPassions>
      <li>Social</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>master of negotiations</label>
