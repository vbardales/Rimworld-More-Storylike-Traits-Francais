  <TraitDef>
    <defName>HYPSSR14ArtZoneDivision</defName><!-- 艺术带师 -->
    <commonality>0.1</commonality>
    <forcedPassions>
      <li>Artistic</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>art master</label>
        <description>They say a thousand readers hold a thousand different Hamlets. {PAWN_nameDef}'s work does not permit that. It takes the visitor by the elbow and walks them into beauty — {PAWN_possessive} beauty, the one {PAWN_pronoun} had in mind, whether or not they had one of their own. Nothing inspires {PAWN_objective} but the next piece.</description>
