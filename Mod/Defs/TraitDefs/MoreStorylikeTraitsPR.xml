          <GeneralLaborSpeed>0.5</GeneralLaborSpeed>
        </statOffsets>
        <skillGains>
          <Artistic>5</Artistic>
        </skillGains>
        <disallowedInspirations>
          <li>Frenzy_Go</li>
          <li>Frenzy_Work</li>
          <li>Frenzy_Shoot</li>
          <li>Inspired_Trade</li>
