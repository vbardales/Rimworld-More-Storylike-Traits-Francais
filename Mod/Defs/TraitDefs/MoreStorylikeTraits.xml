<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    The rarity tiers of the original, and the colour each one paints its label with.

    The colour is NOT in the labels below. It is applied per language, in
    Languages/*/DefInjected/TraitDef, exactly as the original did it - and that is deliberate.
    RimWorld builds a DefInjected key from the normalised English label, dropping everything
    outside [A-Za-z0-9_]. Putting the markup in the label here would turn the key for
    "screen photographer" into `color33ff00screen_photographercolor`, which every future
    translator would then have to type. The cost of keeping it out is that a language this mod
    does not ship - French, German, Russian - falls back to the plain English label and loses the
    tier colouring. That was already true of the original.

      R    green  #33ff00        commonality 0.63        a knack, about half a vanilla trait
      SR   blue   #66ccff        commonality 0.21        a career, with a bill attached
      SSR  purple #cc33cc        commonality 0.10        master of one thing and nothing else
      UR   red    #FF3030        commonality 0.02-0.04   the ones that bend the game
      W    grey   #969696        commonality 0.21        a real handicap with one consolation
      N    plain  (no colour)    commonality 0.21-0.31   even trades

    Every number below is the original author's, unchanged. What that costs at the trait table is
    written up in README.md.
  -->

  <!-- ============================ R - green ============================ -->

  <TraitDef>
    <defName>HYPR01TakeScreenBrother</defName><!-- 拍屏老哥 -->
    <commonality>0.63</commonality>
    <commonalityFemale>0.1</commonalityFemale>
    <degreeDatas>
      <li>
        <label>screen photographer</label>
        <description>Rather than capture the screen like everyone else, {PAWN_nameDef} photographs the monitor with a handheld camera and posts that. It is a fast way to get a thread going. It is not a good way to be read, and the forum has been telling {PAWN_objective} so for years.</description>
        <marketValueFactorOffset>0.05</marketValueFactorOffset>
        <statOffsets>
          <GeneralLaborSpeed>0.15</GeneralLaborSpeed>
          <ShootingAccuracyPawn>-3</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </degreeDatas>
    <conflictingTraits>
      <li>HYPR02TeacherRaosSecretDict</li>
    </conflictingTraits>
    <requiredWorkTags>
      <li>Crafting</li>
    </requiredWorkTags>
  </TraitDef>

