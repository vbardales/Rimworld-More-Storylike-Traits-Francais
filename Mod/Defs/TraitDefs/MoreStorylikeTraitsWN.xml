<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    W (grey) and N (no colour): the bottom of the scale, and the only tier the author left
    uncoloured. N traits are even trades - something given, something taken - and are the closest
    thing here to a vanilla trait. See MoreStorylikeTraits.xml for the whole scale.
  -->

  <!-- ============================ W - grey ============================ -->

  <TraitDef>
    <defName>HYPW01Ignoramus</defName><!-- 不学无术 -->
    <commonality>0.21</commonality>
    <degreeDatas>
      <li>
        <label>unlettered</label>
        <description>{PAWN_nameDef} has never seen the appeal of any job that happens inside {PAWN_possessive} head, and has arranged {PAWN_possessive} life so as to avoid them. What can be said for {PAWN_objective} — and it is the only thing that can be said for {PAWN_objective} — is that {PAWN_pronoun} is a good deal stronger than the rest of you.</description>
        <statOffsets>
          <CarryingCapacity>50</CarryingCapacity>
          <WorkSpeedGlobal>-0.1</WorkSpeedGlobal>
          <GlobalLearningFactor>-0.25</GlobalLearningFactor>
        </statOffsets>
        <skillGains>
          <Shooting>-1</Shooting>
          <Melee>-1</Melee>
          <Social>-1</Social>
          <Animals>-1</Animals>
          <Medicine>-1</Medicine>
          <Cooking>-1</Cooking>
          <Construction>-1</Construction>
          <Plants>-1</Plants>
          <Mining>-1</Mining>
          <Artistic>-1</Artistic>
          <Crafting>-1</Crafting>
          <Intellectual>-1</Intellectual>
        </skillGains>
      </li>
    </degreeDatas>
    <conflictingTraits>
      <li>HYPSSR02RuthlessWorkMachine</li>
      <li>HYPR14StudyOne</li>
      <li>HYPUR04SuperArtificialIntelligence</li>
      <li>HYPSR12ObviouslyAndClearly</li>
      <li>HYPR15OfCourseUseful</li>
      <li>HYPSR09CarIntoBeads</li>
    </conflictingTraits>
  </TraitDef>

  <TraitDef>
    <defName>HYPW02ExtremelyObese</defName><!-- 异常肥胖 -->
    <commonality>0.21</commonality>
    <degreeDatas>
      <li>
        <label>extremely obese</label>
        <description>Years of irregular hours and complete indifference to what was on the plate have made {PAWN_nameDef} very large indeed. {PAWN_pronoun} is slow, {PAWN_pronoun} eats an enormous amount, and people talk over {PAWN_objective}. {PAWN_pronoun} also takes a hit better than anyone in the colony and puts a great deal behind {PAWN_possessive} own.</description>
        <statOffsets>
          <MoveSpeed>-0.2</MoveSpeed>
          <IncomingDamageFactor>-0.3</IncomingDamageFactor>
          <HungerRateMultiplier>0.8</HungerRateMultiplier>
          <SocialImpact>-0.25</SocialImpact>
          <MeleeDPS>0.2</MeleeDPS>
        </statOffsets>
        <statFactors>
          <Mass>3</Mass>
          <MeatAmount>3</MeatAmount>
          <LeatherAmount>1.8</LeatherAmount>
        </statFactors>
        <skillGains>
          <Melee>2</Melee>
        </skillGains>
      </li>
    </degreeDatas>
    <requiredWorkTags>
      <li>Intellectual</li>
    </requiredWorkTags>
  </TraitDef>

  <!-- ============================ N - no colour ============================ -->

  <TraitDef>
    <defName>HYPN01FinelyCrafted</defName><!-- 精雕细琢 -->
    <commonality>0.31</commonality>
    <forcedPassions>
      <li>Artistic</li>
      <li>Crafting</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>good work takes time</label>
        <description>{PAWN_nameDef} holds that good work is never late, it is only good, and behaves accordingly. {PAWN_pronoun} walks slowly. {PAWN_pronoun} works slowly. When the mood is right, nothing inspires {PAWN_objective} but the idea {PAWN_pronoun} has been circling for a week.</description>
        <statOffsets>
          <MoveSpeed>-0.2</MoveSpeed>
          <WorkSpeedGlobal>-0.1</WorkSpeedGlobal>
        </statOffsets>
        <disallowedInspirations>
          <li>Frenzy_Go</li>
          <li>Frenzy_Work</li>
          <li>Frenzy_Shoot</li>
          <li>Inspired_Trade</li>
          <li>Inspired_Recruitment</li>
          <li>Inspired_Taming</li>
          <li>Inspired_Surgery</li>
        </disallowedInspirations>
      </li>
    </degreeDatas>
    <conflictingTraits>
      <li>HYPSSR02RuthlessWorkMachine</li>
      <li>HYPSSR05TheUltimateBricklayer</li>
      <li>HYPSSR06BloodthirstyViking</li>
      <li>HYPSSR07FieldSniper</li>
      <li>HYPSSR10YuZuSoftFan</li>
      <li>HYPSSR12DolphinVoiceTalent</li>
      <li>HYPSSR14ArtZoneDivision</li>
      <li>HYPSSR15MasterOfNegotiations</li>
      <li>HYPUR03TheDealWithLucifer</li>
      <li>HYPSSR13FirearmsExpert</li>
    </conflictingTraits>
    <requiredWorkTags>
      <li>Artistic</li>
      <li>Crafting</li>
    </requiredWorkTags>
  </TraitDef>

  <TraitDef>
    <defName>HYPN02TheArrowInTheKnee</defName><!-- 膝盖中箭 -->
    <commonality>0.21</commonality>
    <forcedPassions>
      <li>Shooting</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>arrow in the knee</label>
        <description>{PAWN_nameDef} was an adventurer once, until {PAWN_pronoun} took an arrow in the knee. What saved {PAWN_objective} was the archery {PAWN_pronoun} had drilled every evening for years: the party could not afford to leave behind the one who could still shoot. {PAWN_pronoun} limped back to the guild hall, handed in {PAWN_possessive} licence, and has never run anywhere since.</description>
        <statOffsets>
          <MoveSpeed>-0.4</MoveSpeed>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
          <AimingDelayFactor>-0.15</AimingDelayFactor>
        </statOffsets>
        <skillGains>
          <Shooting>2</Shooting>
        </skillGains>
      </li>
    </degreeDatas>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
  </TraitDef>

  <TraitDef>
    <defName>HYPN03OnTheSameHandAndFoot</defName><!-- 同手同脚 -->
    <commonality>0.21</commonality>
    <degreeDatas>
      <li>
        <label>same hand, same foot</label>
        <description>{PAWN_nameDef} walks wrong. The right arm goes forward with the right leg, every stride, and has done since {PAWN_pronoun} learned to walk at all. Strangely, it is faster. Just as strangely, it is no use whatsoever in a fight.</description>
        <statOffsets>
          <MoveSpeed>0.3</MoveSpeed>
          <MeleeHitChance>-2</MeleeHitChance>
          <ShootingAccuracyPawn>-2</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

</Defs>
