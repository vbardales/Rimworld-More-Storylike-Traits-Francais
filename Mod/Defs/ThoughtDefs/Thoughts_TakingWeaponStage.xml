<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    What these people think about the weapon in their hands, on ThoughtWorker_IsCarryingRangedWeapon.

    There is no matching vanilla worker for a MELEE weapon, which is why the tai chi inheritor and
    the viking can only be made unhappy about a rifle rather than happy about a sword. The original
    author left a note about it in the 1.3 file, in Chinese, next to the descendant's thought:
    "Tynan did not provide a melee-carrying hook, so this is not implemented." Still true in 1.6.
  -->

  <ThoughtDef>
    <defName>HYPRaohappy</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPR02TeacherRaosSecretDict</li>
    </requiredTraits>
    <stages>
      <li>
        <label>armed, and framing the shot</label>
        <description>Time to teach the people who photograph their screens a lesson.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPMasterhappy</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPR04MasterSection</li>
    </requiredTraits>
    <stages>
      <li>
        <label>armed at range</label>
        <description>I do not need to see the screen. I would still rather have the ranged option.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPPlayerhappy</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPSR01NeverCheat</li>
    </requiredTraits>
    <stages>
      <li>
        <label>armed at range</label>
        <description>This one I like. This one lets people see what I can actually do.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPKnightUnhappy</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPR05EraHasChanged</li>
    </requiredTraits>
    <stages>
      <li>
        <label>a knight with a gun</label>
        <description>What is this? Has the era changed?</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPDescendantUnhappy</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPSR02DescendantsOfTaiChi</li>
    </requiredTraits>
    <stages>
      <li>
        <label>nothing to borrow</label>
        <description>A gun keeps the fight at a distance, and everything I know happens up close. Give me a stick, even. I would rather have the stick.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPRangeWeaponHappy</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPRMC11Player</li>
      <li>HYPSSR07FieldSniper</li>
      <li>HYPSSR13FirearmsExpert</li>
    </requiredTraits>
    <stages>
      <li>
        <label>armed at range</label>
        <description>Good. Let's move.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPRangeWeaponHappyChicken</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPR10ChickenFarmer</li>
    </requiredTraits>
    <stages>
      <li>
        <label>armed at range</label>
        <description>Today is the day I finally shoot a chicken.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPRangeWeaponVikingUnhappy</defName>
    <workerClass>ThoughtWorker_IsCarryingRangedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPSSR06BloodthirstyViking</li>
    </requiredTraits>
    <stages>
      <li>
        <label>a viking with a gun</label>
        <description>I wanted to drink out of the enemy's skull. They handed me a rifle.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
