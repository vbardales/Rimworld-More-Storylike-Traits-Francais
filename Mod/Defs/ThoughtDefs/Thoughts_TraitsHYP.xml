<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Standing thoughts that come with a trait rather than with an event.

    Two of them borrow the night owl's day/night workers, which is the only vanilla hook that asks
    "is it currently daytime for this pawn" - the builder is cheerful in the morning, the
    civilization player is wrecked by it.
  -->

  <ThoughtDef>
    <defName>HYPSR03JustMoreWondersDay</defName>
    <workerClass>ThoughtWorker_IsDayForNightOwl</workerClass>
    <requiredTraits>
      <li>HYPSR03JustMoreWonders</li>
    </requiredTraits>
    <stages>
      <li>
        <label>one more turn, in daylight</label>
        <description>I did not sleep. I am wrecked. I would still like one more turn.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPSR03JustMoreWondersNight</defName>
    <workerClass>ThoughtWorker_IsNightForNightOwl</workerClass>
    <requiredTraits>
      <li>HYPSR03JustMoreWonders</li>
    </requiredTraits>
    <stages>
      <li>
        <label>one more turn</label>
        <description>One more turn. I swear this is the last one, and then I sleep.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPSR05TheSecretOfNewOrientalUnhappy</defName>
    <workerClass>ThoughtWorker_AlwaysActive</workerClass>
    <requiredTraits>
      <li>HYPSR05TheSecretOfNewOriental</li>
    </requiredTraits>
    <stages>
      <li>
        <label>the other half of the cookbook</label>
        <description>The recipes were the harmless part. I should not have read the rest.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPBuilderHappy</defName>
    <workerClass>ThoughtWorker_IsDayForNightOwl</workerClass>
    <requiredTraits>
      <li>HYPR06Constructor</li>
    </requiredTraits>
    <stages>
      <li>
        <label>a good day to build</label>
        <description>Good weather, good light. A good day to put something up.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPBuilderHappyNight</defName>
    <workerClass>ThoughtWorker_IsNightForNightOwl</workerClass>
    <requiredTraits>
      <li>HYPR06Constructor</li>
    </requiredTraits>
    <stages>
      <li>
        <label>a day's work behind me</label>
        <description>Hard day. Full day. It is a good feeling, having it be over.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPSR01NeverCheatNoProsthetic</defName>
    <workerClass>ThoughtWorker_HasAddedBodyPart</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <invert>true</invert>
    <requiredTraits>
      <li>HYPSR01NeverCheat</li>
    </requiredTraits>
    <stages>
      <li>
        <label>nothing but flesh</label>
        <description>Flesh is so limiting. I keep missing, and everyone keeps watching me miss.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPSR01NeverCheatProsthophileHappy</defName>
    <workerClass>ThoughtWorker_HasAddedBodyPart</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>HYPSR01NeverCheat</li>
    </requiredTraits>
    <!--
      Six stages and the same mood curve as vanilla's ProsthophileHappy (4/7/9/11/12/13), which is
      what ThoughtWorker_HasAddedBodyPart counts up to. The joke is that the accusation was always
      that this one had something installed that ordinary players did not.
    -->
    <stages>
      <li>
        <label>one artificial part</label>
        <description>Nice piece of hardware. I want more.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
      <li>
        <label>two artificial parts</label>
        <description>Two of them. Winner winner.</description>
        <baseMoodEffect>7</baseMoodEffect>
      </li>
      <li>
        <label>three artificial parts</label>
        <description>Three. Somebody pour me something expensive.</description>
        <baseMoodEffect>9</baseMoodEffect>
      </li>
      <li>
        <label>four artificial parts</label>
        <description>Four. This is getting uncomfortable, and I do not care.</description>
        <baseMoodEffect>11</baseMoodEffect>
      </li>
      <li>
        <label>five artificial parts</label>
        <description>Five. Everyone watching right now is family to me.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
      <li>
        <label>rebuilt</label>
        <description>I told you all. I have never cheated.</description>
        <baseMoodEffect>13</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPSR11UnspeakableHorrorHappy</defName>
    <workerClass>ThoughtWorker_AlwaysActive</workerClass>
    <requiredTraits>
      <li>HYPSR11UnspeakableHorror</li>
    </requiredTraits>
    <stages>
      <li>
        <label>blessed</label>
        <description>Oh, my holy father.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPSSR02RuthlessWorkMachineUnhappy</defName>
    <workerClass>ThoughtWorker_AlwaysActive</workerClass>
    <requiredTraits>
      <li>HYPSSR02RuthlessWorkMachine</li>
    </requiredTraits>
    <stages>
      <li>
        <label>never satisfied</label>
        <description>This colony could be better. It could be better. It could be better.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
