<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Kill memories. Vanilla gives a psychopath and a bloodlust pawn their own thought on a kill;
    these two do the same for the streamer who was accused of aiming for him, and for the viking.
    Both use the vanilla skull icon and both stack five deep over six days, exactly like
    KilledHumanlikeBloodlust.
  -->

  <ThoughtDef>
    <defName>HYPSKS17Happy</defName>
    <icon>Things/Mote/ThoughtSymbol/Skull</icon>
    <showBubble>true</showBubble>
    <durationDays>6</durationDays>
    <stackLimit>5</stackLimit>
    <requiredTraits>
      <li>HYPSR01NeverCheat</li>
    </requiredTraits>
    <stages>
      <li>
        <label>killed someone</label>
        <description>I hit what I aimed at, in front of witnesses. Like I have been saying for years: I have never cheated.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HYPVikingHappy</defName>
    <icon>Things/Mote/ThoughtSymbol/Skull</icon>
    <showBubble>true</showBubble>
    <durationDays>6</durationDays>
    <stackLimit>5</stackLimit>
    <requiredTraits>
      <li>HYPSSR06BloodthirstyViking</li>
    </requiredTraits>
    <stages>
      <li>
        <label>killed someone</label>
        <description>I killed someone! I am going to drink out of his skull.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
