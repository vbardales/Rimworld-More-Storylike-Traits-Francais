<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Twelve social thoughts: what the rest of the colony makes of someone carrying one of these
    traits. All of them run through one worker, MoreStorylikeTraits.ThoughtWorker_MSTSpecial, and
    the conditions live in an MSTModExtension on each def rather than in code - which is why the
    mod ships a 90-line assembly instead of twelve workers.

    `triggerTraits` is read off the OTHER pawn, the one being looked at. `validWithDisfigured` is
    true throughout: the author wanted these opinions to survive a ruined face, and one of them
    is about a ruined face.
  -->

  <ThoughtDef>
    <defName>HYPRThought01CombatExpert</defName><!-- 战斗专家 -->
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>MoreStorylikeTraits.ThoughtWorker_MSTSpecial</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>knows how to fight</label>
        <baseOpinionOffset>10</baseOpinionOffset>
      </li>
    </stages>
    <modExtensions>
      <li Class="MoreStorylikeTraits.MSTModExtension">
        <sameFactionOnly>true</sameFactionOnly>
        <validWithDisfigured>true</validWithDisfigured>
        <triggerTraits>
          <li>HYPR04MasterSection</li>
          <li>HYPSR01NeverCheat</li>
          <li>HYPR05EraHasChanged</li>
          <li>HYPSR02DescendantsOfTaiChi</li>
        </triggerTraits>
      </li>
    </modExtensions>
  </ThoughtDef>

